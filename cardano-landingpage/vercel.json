{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/webshop", "destination": "https://cardano.gleichbeidir.at/bestellen", "permanent": true },
    { "source": "/webshop/:path*", "destination": "https://cardano.gleichbeidir.at/bestellen", "permanent": true },
    { "source": "/bestellen", "destination": "https://cardano.gleichbeidir.at/bestellen", "permanent": true },
    { "source": "/ios", "destination": "https://apps.apple.com/at/app/cardano-kebapizza-wien/id6820425257", "permanent": true },
    { "source": "/android", "destination": "https://play.google.com/store/apps/details?id=at.cardano.gleichbeidir&hl=de", "permanent": true }
  ],
  "headers": [
    { "source": "/(img|icons|fonts)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
